# ---- LLM provider -----------------------------------------------------------
# openai | openrouter  (leave unset to auto-detect: OpenRouter if key present)
# LLM_PROVIDER=openrouter

# ---- OpenRouter (recommended) ----------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free   # free model (no credits)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=http://localhost:5000
# OPENROUTER_APP_NAME=GraphHacks

# ---- OpenAI -----------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1     # or http://localhost:11434/v1 for Ollama
LLM_MODEL=gpt-4o-mini

# ---- FalkorDB (optional — without it an in-memory graph is used) ----------
# Option 1: cloud (paste the connection URL from app.falkordb.cloud)
# FALKORDB_URL=falkor://user:password@host:port

# Option 2: local Docker
# docker run -d -p 6379:6379 -p 3000:3000 falkordb/falkordb:latest
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379

# ---- demo tuning -----------------------------------------------------------
# seconds each worker "works" on a task (higher = easier to watch live)
WORKER_DELAY=0.8
